DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&schema=skytobi
DATABASE_SCHEMA=skytobi
# Used only by scripts/migrate-database.js. Never configure this on Vercel.
SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@SOURCE_HOST/DATABASE?sslmode=require&schema=source_schema

PORT=5001
NODE_ENV=development
DEFAULT_LIMIT=20
JWT_SECRET=replace-me
ENC_SECRET_KEY=replace-me
SESSION_EXPIRATION_HOUR=24
VERIFICATION_EXPIRATION_HOUR=24
NEXT_PUBLIC_RETURN_APP_BASE=https://www.skytrustfinance.com/online/secure/panel/sign-in.html?emailtoken=
